RunSection(function()
	local HitboxOn = false
	local Range = 7
	local Transparency = 0.7

	local Tracked = {}
	local LastSync = 0
	local DownedUntil = setmetatable({}, { __mode = "k" })
	local DOWN_HOLD = 0.6

	local DOWN_ATTRIBUTES = { "Ragdoll", "Ragdolled", "Knocked", "KnockedDown", "Downed", "Crit", "Crited", "Stunned" }

	local DOWN_STATES = {
		[Enum.HumanoidStateType.FallingDown] = true,
		[Enum.HumanoidStateType.Ragdoll] = true,
		[Enum.HumanoidStateType.Physics] = true,
		[Enum.HumanoidStateType.PlatformStanding] = true,
		[Enum.HumanoidStateType.Dead] = true,
	}

	local function HitboxActive()
		return HitboxOn
	end

	local function IsDowned(Root)
		local Model = Root.Parent
		local Humanoid = Model and Model:FindFirstChildOfClass("Humanoid")

		if not Humanoid then
			return false
		end

		local Now = os.clock()
		local Down = false

		local Ok, State = pcall(function()
			return Humanoid:GetState()
		end)

		if Ok and DOWN_STATES[State] then
			Down = true
		end

		if not Down and Humanoid.PlatformStand then
			Down = true
		end

		if not Down then
			for _, Name in ipairs(DOWN_ATTRIBUTES) do
				if Model:GetAttribute(Name) == true or Humanoid:GetAttribute(Name) == true then
					Down = true
					break
				end
			end
		end

		if not Down and Root.CFrame.UpVector.Y < 0.55 then
			Down = true
		end

		if Down then
			DownedUntil[Root] = Now + DOWN_HOLD
			return true
		end

		local Until = DownedUntil[Root]

		return Until ~= nil and Now < Until
	end

	Shared.IsDowned = IsDowned

	local function Restore(Root)
		local Data = Tracked[Root]

		if not Data then
			return
		end

		Tracked[Root] = nil

		for _, C in ipairs(Data.Conns) do
			C:Disconnect()
		end

		if Root.Parent then
			pcall(function()
				Root.Size = Data.Size
				Root.Transparency = Data.Transparency
				Root.Color = Data.Color
				Root.Material = Data.Material
				Root.CanCollide = Data.CanCollide
			end)
		end
	end

	local function Shape(Root)
		local Target = Vector3.new(Range, Range, Range)

		if Root.Size ~= Target then
			Root.Size = Target
		end

		Root.Transparency = Transparency
		Root.CanCollide = false
	end

	local function Track(Root)
		if Tracked[Root] then
			return
		end

		local Data = {
			Size = Root.Size,
			Transparency = Root.Transparency,
			Color = Root.Color,
			Material = Root.Material,
			CanCollide = Root.CanCollide,
			Conns = {},
		}

		Tracked[Root] = Data

		Root.Color = Color3.new(0, 0, 0)
		Root.Material = Enum.Material.SmoothPlastic

		table.insert(Data.Conns, Root:GetPropertyChangedSignal("Size"):Connect(function()
			if HitboxActive() then
				local Target = Vector3.new(Range, Range, Range)

				if Root.Size ~= Target then
					Root.Size = Target
				end
			end
		end))

		Shape(Root)
	end

	local function GetTargets()
		local List = {}
		local Seen = {}
		local MyCharacter = LocalPlayer.Character

		local function Add(Model)
			if not Model or Model == MyCharacter or not Model:IsA("Model") then
				return
			end

			local Root = Model:FindFirstChild("HumanoidRootPart")

			if Root and Root:IsA("BasePart") and not Seen[Root] and Model:FindFirstChildOfClass("Humanoid") then
				Seen[Root] = true
				List[#List + 1] = Root
			end
		end

		for _, Player in ipairs(Players:GetPlayers()) do
			if Player ~= LocalPlayer then
				Add(Player.Character)
			end
		end

		local Live = workspace:FindFirstChild("Live")

		if Live then
			for _, Child in ipairs(Live:GetChildren()) do
				Add(Child)
			end
		end

		for _, Child in ipairs(workspace:GetChildren()) do
			Add(Child)
		end

		return List
	end

	local function Sync()
		local Present = {}

		for _, Root in ipairs(GetTargets()) do
			local Humanoid = Root.Parent and Root.Parent:FindFirstChildOfClass("Humanoid")

			if Humanoid and Humanoid.Health > 0 and not Shared.ShouldIgnore(Root.Parent, Root) then
				Present[Root] = true
				Track(Root)
			end
		end

		for Root in pairs(Tracked) do
			if not Present[Root] or not Root.Parent then
				Restore(Root)
			end
		end
	end

	local function RestoreAll()
		for Root in pairs(Tracked) do
			Restore(Root)
		end
	end

	local ReachTable
	local ReachOriginal = {}
	local ReachSearched = false

	local function FindReach()
		if ReachSearched then
			return ReachTable
		end

		ReachSearched = true

		pcall(function()
			for _, Inst in ipairs(ReplicatedStorage:GetDescendants()) do
				if Inst:IsA("ModuleScript") and Inst.Name == "Config" then
					local Ok, Result = pcall(require, Inst)

					if Ok and type(Result) == "table"
						and type(Result.Combat) == "table"
						and type(Result.Combat.Reach) == "table" then

						ReachTable = Result.Combat.Reach

						for Key, Value in pairs(ReachTable) do
							if type(Value) == "number" then
								ReachOriginal[Key] = Value
							end
						end

						return
					end
				end
			end
		end)

		return ReachTable
	end

	local function ApplyReach()
		local Reach = FindReach()

		if not Reach then
			return
		end

		local Factor = math.max(Range / (ReachOriginal.Bare or 7), 1)

		pcall(function()
			for Key, Value in pairs(ReachOriginal) do
				Reach[Key] = Value * Factor
			end
		end)
	end

	local function RestoreReach()
		if not ReachTable then
			return
		end

		pcall(function()
			for Key, Value in pairs(ReachOriginal) do
				ReachTable[Key] = Value
			end
		end)
	end

	Conn(RunService.Stepped:Connect(function()
		if not HitboxActive() then
			return
		end

		local Now = os.clock()

		if Now - LastSync >= 0.25 then
			LastSync = Now
			Sync()
		end

		for Root in pairs(Tracked) do
			if Root.Parent then
				if Shared.ShouldIgnore(Root.Parent, Root) then
					Restore(Root)
				else
					Shape(Root)
				end
			end
		end
	end))

	local function Refresh()
		if HitboxActive() then
			Sync()
			ApplyReach()
		else
			RestoreAll()
			RestoreReach()
		end
	end

	OnCleanup(function()
		HitboxOn = false
		RestoreAll()
		RestoreReach()
	end)

	local HitboxToggle = CreateToggle(CombatPage, "Hitbox", false, function(State)
		HitboxOn = State
		Refresh()
	end, "Hitbox")
	HitboxToggle.LayoutOrder = 4

	local RangeSlider = CreateSlider(CombatPage, "Range", 1, 15, 0.1, 7, function(Value)
		Range = Value

		if HitboxActive() then
			for Root in pairs(Tracked) do
				if Root.Parent then
					Shape(Root)
				end
			end

			ApplyReach()
		end
	end, "HitboxRange")
	RangeSlider.LayoutOrder = 5

	local TransparencySlider = CreateSlider(CombatPage, "Transparency", 0.1, 1, 0.1, 0.7, function(Value)
		Transparency = Value

		for Root in pairs(Tracked) do
			if Root.Parent then
				Root.Transparency = Value
			end
		end
	end, "HitboxTransparency")
	TransparencySlider.LayoutOrder = 6

	CreateGap(CombatPage, 6, 7)
end)

RunSection(function()
	local NoDelayOn = false
	local PunchGap = 0.1

	local AttackState

	local function LoadAttackState()
		if AttackState then
			return true
		end

		local Ok, Err = pcall(function()
			local Client = ReplicatedStorage:WaitForChild("Client", 10)

			AttackState = require(Client.Combat.AttackState)
		end)


		return AttackState ~= nil
	end

	task.spawn(LoadAttackState)

	local LastCanAttack = true
	local LockStartedAt = 0
	local LastLoadTry = 0

	Conn(RunService.Heartbeat:Connect(function()
		if not NoDelayOn then
			LastCanAttack = true
			return
		end

		local Now = os.clock()

		if not AttackState then
			if Now - LastLoadTry > 2 then
				LastLoadTry = Now
				task.spawn(LoadAttackState)
			end

			return
		end

		pcall(function()
			local Active = AttackState.Active

			if not Active then
				LastCanAttack = true
				return
			end

			local CanAttack = Active.CanAttack

			if CanAttack == false and LastCanAttack ~= false then
				LockStartedAt = Now
			end

			LastCanAttack = CanAttack

			if CanAttack ~= false then
				return
			end

			if not IsAlive() then
				return
			end

			if Now - LockStartedAt >= PunchGap then
				Active.CanAttack = true
				LastCanAttack = true
			end
		end)
	end))

	local AntiStunOn = false
	local BaseSpeeds = setmetatable({}, { __mode = "k" })

	Conn(RunService.Heartbeat:Connect(function()
		if not AntiStunOn then
			return
		end

		local Active = AttackState and AttackState.Active
		local M1 = Active and Active.CurrentM1

		if not M1 then
			return
		end

		pcall(function()
			if not M1.IsPlaying then
				return
			end

			local Speed = M1.Speed

			if BaseSpeeds[M1] == nil and Speed > 0.2 then
				BaseSpeeds[M1] = Speed
			end

			if Speed > 0 and Speed <= 0.1 then
				M1:AdjustSpeed(BaseSpeeds[M1] or 1)
			end
		end)
	end))

	local PUNCH_IDS = {
		"18312333191", "18312335714", "18312338197", "18312340119",
		"17819438450", "17819441388", "17819444004", "17819446225",
	}

	local STOMP_IDS = { "18362264385", "17837722603" }

	local PunchSpeedOn = false
	local StompSpeedOn = false
	local PunchSpeed = 1.7
	local StompSpeed = 1

	local TrackKinds = setmetatable({}, { __mode = "k" })

	local function HasId(Track, Ids)
		local Animation = Track.Animation

		if not Animation then
			return false
		end

		local AnimId = tostring(Animation.AnimationId)

		for _, Id in ipairs(Ids) do
			if string.find(AnimId, Id, 1, true) then
				return true
			end
		end

		return false
	end

	local function KindOf(Track)
		local Cached = TrackKinds[Track]

		if Cached ~= nil then
			return Cached
		end

		local Kind = false

		if HasId(Track, PUNCH_IDS) then
			Kind = "punch"
		elseif HasId(Track, STOMP_IDS) then
			Kind = "stomp"
		end

		TrackKinds[Track] = Kind

		return Kind
	end

	Conn(RunService.Heartbeat:Connect(function()
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local Animator = Humanoid and Humanoid:FindFirstChildOfClass("Animator")

		if not Animator then
			return
		end

		for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do
			local Kind = KindOf(Track)

			if Kind == "punch" and PunchSpeedOn then
				local Speed = Track.Speed

				if Speed > 0.1 and math.abs(Speed - PunchSpeed) > 0.02 then
					pcall(function()
						Track:AdjustSpeed(PunchSpeed)
					end)
				end
			elseif Kind == "stomp" and StompSpeedOn then
				local Speed = Track.Speed

				if Speed > 0.1 and math.abs(Speed - StompSpeed) > 0.02 then
					pcall(function()
						Track:AdjustSpeed(StompSpeed)
					end)
				end
			end
		end
	end))

	local NoDelayToggle = CreateToggle(CombatPage, "No Punch Delay", false, function(State)
		NoDelayOn = State

		if State then
			task.spawn(LoadAttackState)
		end
	end, "NoAttackDelay")
	NoDelayToggle.LayoutOrder = 8

	local GapSlider = CreateSlider(CombatPage, "Punch Delay", 0, 0.3, 0.01, 0.1, function(Value)
		PunchGap = Value
	end, "PunchGap")
	GapSlider.LayoutOrder = 9

	local NoWeaveDelayToggle = CreateToggle(CombatPage, "No Weave Delay", true, function(State)
		Shared.NoWeaveDelay = State
	end, "NoWeaveDelay")
	NoWeaveDelayToggle.LayoutOrder = 10

	local AntiStunToggle = CreateToggle(CombatPage, "Anti Stun", false, function(State)
		AntiStunOn = State

		if State then
			task.spawn(LoadAttackState)
		end
	end, "AntiStun")
	AntiStunToggle.LayoutOrder = 14

	local PunchSpeedToggle = CreateToggle(CombatPage, "Punch Speed", false, function(State)
		PunchSpeedOn = State
	end, "PunchSpeedOn")
	PunchSpeedToggle.LayoutOrder = 15

	local PunchSpeedSlider = CreateSlider(CombatPage, "Punch Speed Amount", 1.2, 5, 0.1, 1.7, function(Value)
		PunchSpeed = Value
	end, "PunchSpeed")
	PunchSpeedSlider.LayoutOrder = 16

	local StompSpeedToggle = CreateToggle(CombatPage, "Stomp Speed", false, function(State)
		StompSpeedOn = State
	end, "StompSpeedOn")
	StompSpeedToggle.LayoutOrder = 17

	local StompSpeedSlider = CreateSlider(CombatPage, "Stomp Speed Amount", 1, 3, 0.1, 1, function(Value)
		StompSpeed = Value
	end, "StompSpeed")
	StompSpeedSlider.LayoutOrder = 18
end)

RunSection(function()
	local LastConnectedSeq = { Attack = nil, Stomp = nil }

	local ConnectOn = false
	local ConnectRange = 8

	local NoStompOn = false
	local StompGap = 0

	local EasyStompOn = false
	local EasyStompCount = 1
	local EasyStompReach = 8

	local LastLoadTry = 0

	local function EnsureModules()
		if Modules.AttackState and Modules.Combat then
			return true
		end

		local Now = os.clock()

		if Now - LastLoadTry > 2 then
			LastLoadTry = Now
			task.spawn(LoadModules)
		end

		return false
	end

	local function NearestTarget(Range, Filter)
		local Character = LocalPlayer.Character
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Root then
			return nil
		end

		local BestModel = nil
		local BestDistance = Range
		local Seen = {}

		local function Check(Model)
			if not Model or Model == Character or Seen[Model] or not Model:IsA("Model") then
				return
			end

			Seen[Model] = true

			local TargetRoot = Model:FindFirstChild("HumanoidRootPart")
			local Humanoid = Model:FindFirstChildOfClass("Humanoid")

			if not TargetRoot or not Humanoid or Humanoid.Health <= 0 then
				return
			end
			if Filter and Shared.ShouldIgnore(Model, TargetRoot) then
				return
			end

			local Distance = (TargetRoot.Position - Root.Position).Magnitude

			if Distance <= BestDistance then
				BestDistance = Distance
				BestModel = Model
			end
		end

		for _, Player in ipairs(Players:GetPlayers()) do
			if Player ~= LocalPlayer then
				Check(Player.Character)
			end
		end

		local Live = workspace:FindFirstChild("Live")

		if Live then
			for _, Child in ipairs(Live:GetChildren()) do
				Check(Child)
			end
		end

		return BestModel
	end

	local HAND_PARTS = { "RightHand", "LeftHand", "Right Arm", "Left Arm" }
	local FOOT_PARTS = { "RightFoot", "LeftFoot", "Right Leg", "Left Leg" }

	local function ClosestLimb(Character, Names, Position)
		local Best = nil
		local BestDistance = math.huge

		for _, Name in ipairs(Names) do
			local Part = Character:FindFirstChild(Name)

			if Part and Part:IsA("BasePart") then
				local Distance = (Part.Position - Position).Magnitude

				if Distance < BestDistance then
					BestDistance = Distance
					Best = Part
				end
			end
		end

		return Best or Character:FindFirstChild("HumanoidRootPart")
	end

	local function ReportHit(Action, Kind)
		local Active = Modules.AttackState and Modules.AttackState.Active
		local Combat = Modules.Combat
		local Character = LocalPlayer.Character

		if not ConnectOn or not Active or not Combat or not Character or not IsAlive() then
			return
		end

		local Current = Kind == "Stomp" and Active.CurrentAction or Active.CurrentM1

		if Current ~= Action then
			return
		end

		local StillPlaying = false

		pcall(function()
			StillPlaying = Action.IsPlaying
		end)

		if not StillPlaying then
			return
		end

		local Model = NearestTarget(ConnectRange, true)

		if not Model then
			return
		end

		local TargetPart = Model:FindFirstChild("UpperTorso")
			or Model:FindFirstChild("Torso")
			or Model:FindFirstChild("HumanoidRootPart")

		if not TargetPart then
			return
		end

		local Limb = ClosestLimb(Character, Kind == "Stomp" and FOOT_PARTS or HAND_PARTS, TargetPart.Position)

		if not Limb then
			return
		end

		local Seq = Active.Seq

		if type(Seq) ~= "number" or LastConnectedSeq[Kind] == Seq then
			return
		end

		LastConnectedSeq[Kind] = Seq

		pcall(function()
			Combat.HitReport:Fire(Seq, TargetPart, Limb.Position)
		end)
	end

	local LastAttackInputAt = -100
	local AttackInputHooked = false

	Conn(UserInputService.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch
			or Input.KeyCode == Enum.KeyCode.ButtonR2 then
			LastAttackInputAt = os.clock()
		end
	end))

	local function AttackInputRecent()
		if os.clock() - LastAttackInputAt <= 0.6 then
			return true
		end

		local Held = false

		pcall(function()
			Held = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
				or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonR2)
		end)

		return Held
	end

	local ActionTokens = { Attack = 0, Stomp = 0 }

	local function OnAction(Action, Kind)
		ActionTokens[Kind] = ActionTokens[Kind] + 1

		local Mine = ActionTokens[Kind]
		local Fired = false
		local Marker = nil

		local function Fire()
			if Fired or Mine ~= ActionTokens[Kind] then
				return
			end

			Fired = true

			if Marker then
				Marker:Disconnect()
				Marker = nil
			end

			task.spawn(ReportHit, Action, Kind)
		end

		pcall(function()
			Marker = Action:GetMarkerReachedSignal("Start"):Connect(Fire)
		end)

		task.delay(0.1, Fire)
	end

	local LastM1 = nil
	local LastTime = 0

	Conn(RunService.Heartbeat:Connect(function()
		if not ConnectOn then
			LastM1 = nil
			return
		end

		if not EnsureModules() then
			return
		end

		if not AttackInputHooked and Modules.Input then
			AttackInputHooked = true

			pcall(function()
				Modules.Input.Began:Connect(function(Action)
					if Action == "Attack" then
						LastAttackInputAt = os.clock()
					end
				end)
			end)
		end

		local Active = Modules.AttackState.Active
		local M1 = Active and Active.CurrentM1

		if not M1 then
			LastM1 = nil
			return
		end

		local Playing = false
		local TimePosition = 0

		pcall(function()
			Playing = M1.IsPlaying
			TimePosition = M1.TimePosition
		end)

		local Restarted = Playing and M1 == LastM1 and TimePosition + 0.02 < LastTime
		LastTime = TimePosition

		if Playing and (M1 ~= LastM1 or Restarted) then
			LastM1 = M1

			if AttackInputRecent() then
				OnAction(M1, "Attack")
			end
		elseif not Playing then
			LastM1 = nil
		end
	end))

	local function StompPlan(Count)
		if Count >= 7 then
			return 2, 6
		elseif Count == 6 then
			return 1, 5
		end

		return 0, Count
	end

	local function SendStompHit(Model)
		local Active = Modules.AttackState and Modules.AttackState.Active
		local Combat = Modules.Combat
		local Character = LocalPlayer.Character

		if not Active or not Combat or not Character or not IsAlive() then
			return
		end

		local Target = Model:FindFirstChild("UpperTorso")
			or Model:FindFirstChild("Torso")
			or Model:FindFirstChild("HumanoidRootPart")

		if not Target then
			return
		end

		local Foot = ClosestLimb(Character, FOOT_PARTS, Target.Position)

		Active.Seq = (Active.Seq or 0) + 1

		local Seq = Active.Seq

		pcall(function()
			Combat.Swing:Fire(Seq, "Stomp", "RightHand")
		end)

		task.wait(0.04)

		if Target.Parent and Foot then
			pcall(function()
				Combat.HitReport:Fire(Seq, Target, Foot.Position)
			end)
		end
	end

	local function SendMultiHit(Model)
		local Active = Modules.AttackState and Modules.AttackState.Active
		local Combat = Modules.Combat
		local Character = LocalPlayer.Character

		if not Active or not Combat or not Character or not IsAlive() then
			return
		end

		local Target = Model:FindFirstChild("UpperTorso")
			or Model:FindFirstChild("Torso")
			or Model:FindFirstChild("HumanoidRootPart")

		if not Target then
			return
		end

		local Hand = Character:FindFirstChild("LeftHand") or Character:FindFirstChild("HumanoidRootPart")

		Active.Seq = (Active.Seq or 0) + 1

		local Seq = Active.Seq

		pcall(function()
			Combat.Swing:Fire(Seq, "Attack", "LeftHand")
		end)

		task.wait(0.04)

		if Target.Parent and Hand then
			pcall(function()
				Combat.HitReport:Fire(Seq, Target, Hand.Position)
			end)
		end
	end

	local function StompMultiFire()
		if not EasyStompOn or not IsAlive() or not HasFight() then
			return
		end

		local Model = NearestTarget(EasyStompReach)

		if not Model then
			return
		end

		local Stomps, Hits = StompPlan(EasyStompCount)

		for _ = 1, Stomps do
			task.spawn(SendStompHit, Model)
		end

		for _ = 1, Hits do
			task.spawn(SendMultiHit, Model)
		end
	end

	local StompToken = 0
	local InStomp = false
	local StompStartedAt = -100
	local StompMarker = nil

	local function CritWanted()
		return Shared.IsCritOn ~= nil and Shared.IsCritOn()
	end

	local function OnStompStart(Active)
		StompToken = StompToken + 1

		local Mine = StompToken
		local Fired = false

		if StompMarker then
			StompMarker:Disconnect()
			StompMarker = nil
		end

		local function Fire()
			if Fired or Mine ~= StompToken then
				return
			end

			Fired = true

			if StompMarker then
				StompMarker:Disconnect()
				StompMarker = nil
			end

			if EasyStompOn then
				StompMultiFire()
			end

			if CritWanted() and Shared.CritStomp then
				task.spawn(Shared.CritStomp)
			end
		end

		pcall(function()
			if Active.CurrentAction then
				StompMarker = Active.CurrentAction:GetMarkerReachedSignal("Start"):Connect(Fire)
			end
		end)

		task.delay(0.34, Fire)
	end

	local function StompTick()
		if not NoStompOn and not EasyStompOn and not CritWanted() then
			InStomp = false
			return
		end

		local AttackStateModule = Modules.AttackState

		if not AttackStateModule then
			EnsureModules()
			return
		end

		local Active = AttackStateModule.Active

		if not Active then
			return
		end

		local Stomping = Active.Stomping == true
		local IsStomp = Stomping and Active.CurrentKind == "Stomp"

		if IsStomp and not InStomp then
			InStomp = true
			StompStartedAt = os.clock()
			OnStompStart(Active)
		elseif not Stomping then
			InStomp = false
		end

		if NoStompOn and IsStomp and os.clock() - StompStartedAt >= StompGap then
			Active.CanAttack = true
			Active.Stomping = false
		end
	end

	Conn(RunService.Stepped:Connect(StompTick))
	Conn(RunService.Heartbeat:Connect(StompTick))
	Conn(RunService.RenderStepped:Connect(StompTick))

	local ConnectToggle = CreateToggle(CombatPage, "Auto Connect", false, function(State)
		ConnectOn = State

		if State then
			task.spawn(LoadModules)
		end
	end, "AutoConnect")
	ConnectToggle.LayoutOrder = 1

	local ConnectSlider = CreateSlider(CombatPage, "Connect Range", 2, 17, 0.1, 8, function(Value)
		ConnectRange = Value
	end, "ConnectRange")
	ConnectSlider.LayoutOrder = 2

	local IgnoreRow = New("Frame", {
		Size = UDim2.new(1, -2, 0, 42),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = 3,
	}, CombatPage)

	New("UIListLayout", {
