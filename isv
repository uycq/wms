local function CycleColor(Colors, X)
	local N = #Colors
	local P = (X % 1) * N
	local I = math.floor(P)
	return Colors[I % N + 1]:Lerp(Colors[(I + 1) % N + 1], P - I)
end

function Anim.Add(Gradient, Colors, Speed)
	table.insert(Anim.Items, { G = Gradient, C = Colors, S = Speed or 0.25 })
end

