	local UserGameSettings = UserSettings():GetService("UserGameSettings")
	local SensDefault = 1
	local GamepadDefault = 1

	pcall(function()
		SensDefault = UserGameSettings.MouseSensitivity
	end)

	pcall(function()
		GamepadDefault = UserGameSettings.GamepadCameraSensitivity
	end)

	if not SensDefault or SensDefault <= 0 then
		SensDefault = 1
	end

	if not GamepadDefault or GamepadDefault <= 0 then
		GamepadDefault = 1
	end

	local function ApplySens()
		pcall(function()
			local Want = SensDefault * SensValue

			if math.abs(UserGameSettings.MouseSensitivity - Want) > 0.0001 then
				UserGameSettings.MouseSensitivity = Want
			end
		end)

		pcall(function()
			local Want = GamepadDefault * SensValue

			if math.abs(UserGameSettings.GamepadCameraSensitivity - Want) > 0.0001 then
				UserGameSettings.GamepadCameraSensitivity = Want
			end
		end)
	end

	local function RestoreSens()
		pcall(function()
			UserGameSettings.MouseSensitivity = SensDefault
		end)

		pcall(function()
			UserGameSettings.GamepadCameraSensitivity = GamepadDefault
		end)
	end

	pcall(function()
		RunService:UnbindFromRenderStep("IsaevSens")
	end)

	RunService:BindToRenderStep("IsaevSens", Enum.RenderPriority.Camera.Value - 1, function()
		if SensOn then
			ApplySens()
		end
	end)

