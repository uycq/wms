		WatchCharacter(Character)
	end))

	do
		local PUSH_SPEED = 15
		local PUSH_TIME = 0.2
		local PUSH_FORCE = 100000
		local BASE_SPEED = 10
		local CUTOFF = 0.9

		local AnimSets = {
			Boxer = {
				Front = "rbxassetid://17819683172",
