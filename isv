	local function AirStop()
		if AirForce then
			AirForce:Destroy()
			AirForce = nil
		end

		if AirAttach then
			AirAttach:Destroy()
			AirAttach = nil
		end
	end

	local function AirStep()
		if not (AirWalkOn and AirActive()) then
			if AirForce then
				AirStop()
			end

			return
		end

		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Humanoid or not Root or Humanoid.Health <= 0 then
			AirStop()
			return
		end

		if Humanoid.FloorMaterial ~= Enum.Material.Air then
			AirStop()
			return
		end

		local Lift = Vector3.new(0, workspace.Gravity * Root.AssemblyMass, 0)

		if not AirForce or AirForce.Parent ~= Root then
			AirStop()

			AirAttach = Instance.new("Attachment")
			AirAttach.Name = "IsaevAirAttach"
			AirAttach.Parent = Root

			AirForce = Instance.new("VectorForce")
			AirForce.Name = "IsaevAirHold"
			AirForce.Attachment0 = AirAttach
			AirForce.RelativeTo = Enum.ActuatorRelativeTo.World
			AirForce.ApplyAtCenterOfMass = true
			AirForce.Force = Lift
			AirForce.Parent = Root

			local V = Root.AssemblyLinearVelocity
			Root.AssemblyLinearVelocity = Vector3.new(V.X, 0, V.Z)
		else
			AirForce.Force = Lift
		end

		local V = Root.AssemblyLinearVelocity
		Root.AssemblyLinearVelocity = Vector3.new(V.X, 0, V.Z)
	end

	local Hold = { Game = false }

	local function Down(Key)
