				LayoutOrder = i,
			}, ListBox)
			Corner(Row, 6)

			New("TextLabel", {
				Size = UDim2.new(1, -118, 1, 0),
				Position = UDim2.new(0, 8, 0, 0),
				BackgroundTransparency = 1,
				Text = name,
				TextColor3 = WHITE,
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, Row)

			New("TextLabel", {
				Size = UDim2.new(0, 110, 1, 0),
