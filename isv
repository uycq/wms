local function CreateToggle(Parent, Text, Default, Callback, Key, Locked)
	local Initial = Default

	if Key and Config[Key] ~= nil then
		Initial = Config[Key] == true
	end

	if Locked then
		Initial = false
	end

	local Holder = New("Frame", {
		Size = UDim2.new(1, -2, 0, 42),
		BackgroundColor3 = Locked and Color3.fromRGB(22, 22, 22) or ROW_BG,
		BackgroundTransparency = ROW_TRANSP,
		BorderSizePixel = 0,
	}, Parent)
	Corner(Holder, 9)
	Stroke(Holder, WHITE, 1, 0.92)

	New("TextLabel", {
		Size = UDim2.new(1, -65, 1, 0),
		Position = UDim2.new(0, 11, 0, 0),
		BackgroundTransparency = 1,
		Text = Text,
		TextColor3 = Locked and Color3.fromRGB(95, 95, 95) or WHITE,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Holder)

	local Switch = New("TextButton", {
		Size = UDim2.new(0, 40, 0, 22),
		Position = UDim2.new(1, -52, 0.5, -11),
		BackgroundColor3 = OFF,
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, Holder)
	Corner(Switch, UDim.new(1, 0))

	local Knob = New("Frame", {
		Size = UDim2.new(0, 16, 0, 16),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, Switch)
	Corner(Knob, UDim.new(1, 0))

	local Enabled = Initial
	local LastShown = nil

	local function Refresh()
		if Locked then
			Switch.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			Knob.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
		else
			Switch.BackgroundColor3 = Enabled and S.A1 or OFF
			Knob.BackgroundColor3 = Enabled and BLACK or WHITE
		end

		local Pos = Enabled and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)

		if LastShown == nil then
			Knob.Position = Pos
		elseif LastShown ~= Enabled then
			TweenService:Create(Knob, TweenInfo.new(0.15), { Position = Pos }):Play()
		end

		LastShown = Enabled
	end

	Switch.MouseButton1Click:Connect(function()
		if Locked then
			return
		end

		Enabled = not Enabled
		Refresh()

		if Key then
			Config[Key] = Enabled
			SaveConfig()
		end

		if Callback then
			Callback(Enabled)
		end
	end)

	table.insert(Refreshers, Refresh)
	Refresh()

	if Key and not Locked then
		FeatureControls[Key] = {
			Get = function()
				return Enabled
			end,
			Set = function(Value)
				Value = Value == true

				if Value == Enabled then
