	AnimClock = AnimClock + dt

	for I = #Anim.Items, 1, -1 do
		local It = Anim.Items[I]

		if not It.G.Parent then
			table.remove(Anim.Items, I)
		else
			local Points = {}
			local Phase = AnimClock * It.S

			for K = 0, 8 do
				Points[#Points + 1] = ColorSequenceKeypoint.new(K / 8, CycleColor(It.C, K / 8 + Phase))
			end

			It.G.Color = ColorSequence.new(Points)
		end
	end
end))

