local dragging, dragStart, startPos
local resizing, resizeStart, startSize
local isOpen = false
local animating = false

Header.InputBegan:Connect(function(input)
	if IsPress(input) then
		dragging = true
		dragStart = input.Position
		startPos = Main.Position
	end
end)

Grip.InputBegan:Connect(function(input)
	if IsPress(input) then
		resizing = true
		resizeStart = input.Position
		startSize = Main.AbsoluteSize
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	if dragging then
		local delta = input.Position - dragStart
		Main.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end

	if resizing then
		local delta = input.Position - resizeStart
		Main.Size = UDim2.fromOffset(
			math.clamp(startSize.X + delta.X, MIN_W, MAX_W),
			math.clamp(startSize.Y + delta.Y, MIN_H, MAX_H)
		)
	end

	if ActiveSlider then
		ActiveSlider(input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if IsPress(input) then
		dragging = false
		resizing = false
		ActiveSlider = nil
	end
end)

local function Open()
	if isOpen or animating then
		return
	end

	isOpen = true
	Main.Visible = true
	Glow.Visible = true
	Cursor.Visible = true
	UserInputService.MouseIconEnabled = false

	local base = Main.Position
	Main.Position = base + UDim2.fromOffset(0, 14)
	Main.GroupTransparency = 1

	TweenService:Create(Main, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = base,
		GroupTransparency = 0,
	}):Play()
end

local function Close()
	if animating or not isOpen then
		return
	end

	animating = true
	isOpen = false

	UserInputService.MouseIconEnabled = true
	Cursor.Visible = false

	local base = Main.Position
	local t = TweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Position = base + UDim2.fromOffset(0, 14),
		GroupTransparency = 1,
	})
	t:Play()

	t.Completed:Connect(function()
		animating = false
		Main.Position = base
		Main.Visible = false
		Glow.Visible = false
	end)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or input.KeyCode ~= Enum.KeyCode.M then
		return
	end

	if UserInputService:GetFocusedTextBox() then
		return
	end

	if isOpen then
		Close()
	else
		Open()
	end
end)

