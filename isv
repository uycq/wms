		local Playing = nil
		local PushId = 0
		local PushBody, PushAnchor = nil, nil
		local Loaded = {}
		local LoadedFor = nil

		local function ClearPush()
			PushId = PushId + 1

			if PushBody then
				PushBody:Destroy()
				PushBody = nil
			end

			if PushAnchor then
				PushAnchor:Destroy()
				PushAnchor = nil
