		if SensOn then
			ApplySens()
		end
	end))

	pcall(function()
		Conn(UserGameSettings:GetPropertyChangedSignal("MouseSensitivity"):Connect(function()
			if SensOn then
				ApplySens()
			end
		end))
	end)

	pcall(function()
		Conn(UserGameSettings:GetPropertyChangedSignal("GamepadCameraSensitivity"):Connect(function()
			if SensOn then
				ApplySens()
			end
		end))
