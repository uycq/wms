local Shared = {}
Shared.NoWeaveDelay = true
Shared.IgnoreKnockedOn = false
Shared.IgnoreTeamOn = false

Shared.IsTeammate = function(Pl)
	if not Pl or Pl == LocalPlayer then
		return false
	end

	local MyOwner = LocalPlayer:GetAttribute("PartyOwner") or 0
	local TheirOwner = Pl:GetAttribute("PartyOwner") or 0

	if MyOwner ~= 0 and (TheirOwner == MyOwner or Pl.UserId == MyOwner) then
		return true
	end

	if TheirOwner ~= 0 and TheirOwner == LocalPlayer.UserId then
		return true
	end

	return false
end

Shared.ShouldIgnore = function(Model, Root)
	if not Model then
		return false
	end

	if Shared.IgnoreTeamOn and Shared.IsTeammate(Players:GetPlayerFromCharacter(Model)) then
		return true
	end

	if Shared.IgnoreKnockedOn and Shared.IsDowned and Root and Shared.IsDowned(Root) then
		return true
	end

	return false
end

