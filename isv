		if SensOn then
			task.wait(0.2)
			ApplySens()
		end
	end))

	if IsMobile then
		local CameraTouch = nil
		local LastTouchPos = nil

		Conn(UserInputService.TouchStarted:Connect(function(Touch, GameProcessed)
			local Camera = workspace.CurrentCamera

			if not SensOn or SensValue == 1 or not Camera then
				return
			end

			local IsLeftHalf = Touch.Position.X < Camera.ViewportSize.X * 0.45

			if not GameProcessed and not IsLeftHalf and not CameraTouch then
				CameraTouch = Touch
				LastTouchPos = Touch.Position
			end
		end))

		Conn(UserInputService.TouchMoved:Connect(function(Touch)
			local Camera = workspace.CurrentCamera

			if not SensOn or Touch ~= CameraTouch or not LastTouchPos or not Camera then
				return
			end

			local Delta = Touch.Position - LastTouchPos
			LastTouchPos = Touch.Position

			local Factor = (SensValue - 1) * 0.003
			Camera.CFrame = Camera.CFrame * CFrame.Angles(0, -Delta.X * Factor, 0)
		end))

		Conn(UserInputService.TouchEnded:Connect(function(Touch)
			if Touch == CameraTouch then
				CameraTouch = nil
				LastTouchPos = nil
			end
		end))
	end

	OnCleanup(function()
		pcall(function()
			RunService:UnbindFromRenderStep("IsaevSens")
		end)

		if SensOn then
			RestoreSens()
		end
	end)

