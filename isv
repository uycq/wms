			end

			ApplyStyle(StyleValue.Value)
			Conn(StyleValue.Changed:Connect(ApplyStyle))
		end)

		Conn(LocalPlayer.CharacterAdded:Connect(function()
			task.wait(0.5)
			Loaded = {}
			LoadedFor = nil
			Reset()
		end))

		FloatStart = function()
