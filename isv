RunSection(function()
	local CritOn = false
	local EasyOn = false
	local EasyCount = 1

	local CritDelay = 0
	local EasyDelay = 0
	local EasySpacing = 0
	local HeavyCooldown = 5.5
	local Reach = 7

	local LastM1 = nil
	local LastTime = 0
	local LastHeavyAt = -100
	local EasyBusy = false

	local function NearestTarget()
		local Character = LocalPlayer.Character
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Root then
			return nil
		end

		local BestPart = nil
		local BestDistance = Reach

		local function Check(Model)
			if not Model or Model == Character or not Model:IsA("Model") then
				return
			end

			local TargetRoot = Model:FindFirstChild("HumanoidRootPart")
			local Humanoid = Model:FindFirstChildOfClass("Humanoid")

			if not TargetRoot or not Humanoid or Humanoid.Health <= 0 then
				return
			end

			local Distance = (TargetRoot.Position - Root.Position).Magnitude

			if Distance <= BestDistance then
				BestDistance = Distance
				BestPart = Model:FindFirstChild("UpperTorso") or TargetRoot
			end
		end

		for _, Player in ipairs(Players:GetPlayers()) do
			if Player ~= LocalPlayer then
				Check(Player.Character)
			end
		end

		local Live = workspace:FindFirstChild("Live")

		if Live then
			for _, Child in ipairs(Live:GetChildren()) do
				Check(Child)
			end
		end

		return BestPart
	end

	local function SendHit(Kind, Hand)
		local Active = Modules.AttackState and Modules.AttackState.Active
		local Combat = Modules.Combat

		if not Active or not Combat or not IsAlive() then
			return false
		end

		local Target = NearestTarget()

		if not Target then
			return false
		end

		Active.Seq = (Active.Seq or 0) + 1

		local Seq = Active.Seq
		local Character = LocalPlayer.Character
		local HandPart = Character and (Character:FindFirstChild(Hand) or Character:FindFirstChild("HumanoidRootPart"))

		pcall(function()
			Combat.Swing:Fire(Seq, Kind, Hand)
		end)

		task.wait(0.04)

		if Target.Parent and HandPart then
			pcall(function()
				Combat.HitReport:Fire(Seq, Target, HandPart.Position)
			end)
		end

		return true
	end

	local function FireHeavy(IgnoreStomp)
		if not CritOn or not IsAlive() or not HasFight() then
			return
		end

		local Now = os.clock()

		if Now - LastHeavyAt < HeavyCooldown then
			return
		end

		if not NearestTarget() then
			return
		end

		local Active = Modules.AttackState and Modules.AttackState.Active

		if Active and (Active.Weaving or Active.Shoving or Active.Slamming or (not IgnoreStomp and Active.Stomping)) then
			return
		end

		LastHeavyAt = Now
		SendHit("Heavy", "RightHand")
	end

	Shared.IsCritOn = function()
		return CritOn
	end

	Shared.CritStomp = function()
		FireHeavy(true)
	end

	local function EasyFire()
		if not EasyOn or EasyBusy then
			return
		end

		EasyBusy = true

		task.spawn(function()
			task.wait(EasyDelay)

			for Index = 1, EasyCount do
				if not EasyOn or not IsAlive() or not HasFight() then
					break
				end

				SendHit("Attack", "LeftHand")

				if Index < EasyCount then
					task.wait(EasySpacing)
				end
			end

			EasyBusy = false
		end)
	end

	Conn(RunService.Heartbeat:Connect(function()
		if not CritOn and not EasyOn then
			LastM1 = nil
			return
		end

		local Active = Modules.AttackState and Modules.AttackState.Active
		local M1 = Active and Active.CurrentM1
		local Playing = false
		local TimePosition = 0

		if M1 then
			pcall(function()
				Playing = M1.IsPlaying
				TimePosition = M1.TimePosition
			end)
		end

		local Restarted = Playing and M1 == LastM1 and TimePosition + 0.02 < LastTime
		LastTime = TimePosition

		if Playing and (M1 ~= LastM1 or Restarted) then
			LastM1 = M1

			if CritOn then
				if CritDelay > 0 then
					task.delay(CritDelay, function()
						FireHeavy(false)
					end)
				else
					FireHeavy(false)
				end
			end

			if EasyOn then
				EasyFire()
			end
		elseif not Playing then
			LastM1 = nil
		end
	end))

	local CritToggle = CreateToggle(KaPage, "Crit Boost", false, function(State)
		CritOn = State
		LastM1 = nil

		if State then
			task.spawn(LoadModules)
		end
	end, "CritBoost")
	CritToggle.LayoutOrder = 1

	local EasyToggle = CreateToggle(KaPage, "Hit Multi", false, function(State)
		EasyOn = State
		LastM1 = nil

		if State then
			task.spawn(LoadModules)
		end
	end, "EasyHit")
	EasyToggle.LayoutOrder = 2

	local EasySlider = CreateSlider(KaPage, "Hit Multi Amount", 1, 5, 1, 1, function(Value)
		EasyCount = Value
	end, "EasyHits")
	EasySlider.LayoutOrder = 3

	CreateGap(KaPage, 6, 6)
end)

RunSection(function()
	local KaOn = false
	local KaRange = 14.3
	local CooldownAll = 0
	local MultiOn = true
	local MultiCount = 3
	local CritOn = true
	local KaMinWeave = 0
	local CooldownSame = 0
	local HitDelay = 0
	local HeavyCooldown = 0
	local PunchTrigger = true
	local SWING_LIMIT = 16
	local SwingTimes = {}
	local LastHeavyAt = -100
	local LastAnyAt = -100
	local LastPlayerAt = {}
	local WeaveState = {}
	local WeaveSince = {}
	local LastWeaveAt = {}
	local AttrConns = {}
	local AnimConns = {}





	local WEAVE_IDS = {
		"18312351760", "18312346524", "18312348771", "18312344029",
		"17819695187", "17819683172", "17819691229", "17819688197",
	}

	local PUNCH_IDS = {
		"18312333191", "18312335714", "18312338197", "18312340119",
		"17819438450", "17819441388", "17819444004", "17819446225",
	}


	local function HasAnyId(Track, Ids)
		local Anim = Track.Animation

		if not Anim then
			return false
		end

		local Id = tostring(Anim.AnimationId)

		for _, X in ipairs(Ids) do
			if string.find(Id, X, 1, true) then
				return true
			end
		end

		return false
	end

	local SeenFrames = setmetatable({}, { __mode = "k" })

	local function WeaveSignal(Char)
		local Frames = Char:GetAttribute("WeaveFrames")

		if type(Frames) == "boolean" then
			SeenFrames[Char] = true
		end

		if Frames == true then
			return true
		end

		if SeenFrames[Char] then
			return false
		end

		local Hum = Char:FindFirstChildOfClass("Humanoid")
		local Animator = Hum and Hum:FindFirstChildOfClass("Animator")

		if Animator then
			for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do
				if Track.WeightTarget > 0 and HasAnyId(Track, WEAVE_IDS) then
					return true
				end
			end
		end

		return false
	end

	local function SwingAllowed(Force)
		local Now = os.clock()

		for I = #SwingTimes, 1, -1 do
			if Now - SwingTimes[I] > 1 then
				table.remove(SwingTimes, I)
			end
		end

		if not Force and #SwingTimes >= SWING_LIMIT then
			return false
		end

		SwingTimes[#SwingTimes + 1] = Now
		return true
	end

	local function SendHit(Kind, Hand, TargetChar, Force)
		local Active = Modules.AttackState and Modules.AttackState.Active
		local Combat = Modules.Combat
		local MyChar = LocalPlayer.Character

		if not Active or not Combat or not MyChar or not TargetChar then
			return
		end

		local Target = TargetChar:FindFirstChild("UpperTorso")
			or TargetChar:FindFirstChild("Torso")
			or TargetChar:FindFirstChild("HumanoidRootPart")

		if not Target or not SwingAllowed(Force) then
			return
		end

		Active.Seq = (Active.Seq or 0) + 1

		local Seq = Active.Seq
		local HandPart = MyChar:FindFirstChild(Hand) or MyChar:FindFirstChild("HumanoidRootPart")

		pcall(function()
			Combat.Swing:Fire(Seq, Kind, Hand)
		end)

		if Target.Parent and HandPart then
			pcall(function()
				Combat.HitReport:Fire(Seq, Target, HandPart.Position)
			end)
		end
	end

	local function Targets(MyRoot)
		local List = {}

		for _, Pl in ipairs(Players:GetPlayers()) do
			if Pl ~= LocalPlayer and not Shared.IsTeammate(Pl) then
				local Char = Pl.Character
				local Root = Char and Char:FindFirstChild("HumanoidRootPart")
				local Hum = Char and Char:FindFirstChildOfClass("Humanoid")

				if Root and Hum and Hum.Health > 0 then
					local Dist = (Root.Position - MyRoot.Position).Magnitude

					if Dist <= KaRange then
						List[#List + 1] = { Char = Char, Dist = Dist }
					end
				end
			end
		end

		table.sort(List, function(a, b)
			return a.Dist < b.Dist
		end)

		return List
	end

	local function Punish(Primary)
		if not Modules.Combat then
			LoadModules()
		end

		local MyChar = LocalPlayer.Character
		local Hum = MyChar and MyChar:FindFirstChildOfClass("Humanoid")
		local MyRoot = MyChar and MyChar:FindFirstChild("HumanoidRootPart")

		if not Hum or Hum.Health <= 0 or not MyRoot or not MyChar:FindFirstChild("Fight") then
			return
		end

		local Active = Modules.AttackState and Modules.AttackState.Active
		local Now = os.clock()
		local DoHeavy = CritOn
			and Now - LastHeavyAt >= HeavyCooldown
			and not (Active and (Active.Weaving or Active.Shoving or Active.Slamming or Active.Stomping))

		if DoHeavy then
			LastHeavyAt = Now
		end

		local Ordered = {}

		for _, T in ipairs(Targets(MyRoot)) do
			if T.Char == Primary then
				table.insert(Ordered, 1, T)
			else
				table.insert(Ordered, T)
			end
		end

		for _, T in ipairs(Ordered) do
			local Force = T.Char == Primary

			SendHit("Attack", "LeftHand", T.Char, Force)

			if DoHeavy then
				SendHit("Heavy", "RightHand", T.Char, Force)
			end

			if MultiOn then
				for _ = 2, MultiCount do
					SendHit("Attack", "LeftHand", T.Char)
				end
			end
		end
	end

	local function Fire(Player, Char, Root)
		if Shared.IsTeammate(Player) then
			return
		end

		local Now = os.clock()

		if Now - (LastPlayerAt[Player] or -100) < CooldownSame then
			return
		end

		if CooldownAll > 0 and Now - LastAnyAt < CooldownAll then
			return
		end

		local MyChar = LocalPlayer.Character
		local MyRoot = MyChar and MyChar:FindFirstChild("HumanoidRootPart")

		if not MyRoot or (MyRoot.Position - Root.Position).Magnitude > KaRange then
			return
		end

		LastAnyAt = Now
		LastPlayerAt[Player] = Now

		if HitDelay > 0 then
			task.delay(HitDelay, Punish, Char)
		else
			Punish(Char)
		end
	end

	local function Evaluate(Player)
		if not KaOn or Shared.IsTeammate(Player) then
			WeaveState[Player] = nil
			WeaveSince[Player] = nil
			return
		end

		local Char = Player.Character
		local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
		local Root = Char and Char:FindFirstChild("HumanoidRootPart")

		if not Char or not Hum or not Root or Hum.Health <= 0 then
			WeaveState[Player] = nil
			WeaveSince[Player] = nil
			return
		end

		local Weaving = WeaveSignal(Char)
		local Was = WeaveState[Player]
		local Now = os.clock()

		WeaveState[Player] = Weaving

		if Weaving then
			LastWeaveAt[Player] = Now

			if not Was then
				WeaveSince[Player] = Now
			end
		end

		if Was and not Weaving then
			if Now - (WeaveSince[Player] or Now) >= KaMinWeave then
				Fire(Player, Char, Root)
			end
		end
	end

	local function HookAnimator(Player, Char)
		if AnimConns[Player] then
			AnimConns[Player]:Disconnect()
			AnimConns[Player] = nil
		end

		task.spawn(function()
			local Hum = Char:WaitForChild("Humanoid", 5)
			local Animator = Hum and Hum:WaitForChild("Animator", 5)

			if not Animator or Player.Character ~= Char then
				return
			end

			AnimConns[Player] = Animator.AnimationPlayed:Connect(function(Track)
				if not KaOn or Shared.IsTeammate(Player) then
					return
				end

				if HasAnyId(Track, WEAVE_IDS) then
					Evaluate(Player)

					Track.Stopped:Once(function()
						Evaluate(Player)
					end)
				elseif PunchTrigger and HasAnyId(Track, PUNCH_IDS) then
					if os.clock() - (LastWeaveAt[Player] or -100) <= 0.6 then
						local Root = Char:FindFirstChild("HumanoidRootPart")

						if Root then
							Fire(Player, Char, Root)
						end
					end
				end
			end)
		end)
	end

	local function HookPlayer(Player)
		if Player == LocalPlayer then
			return
		end

		local function HookChar(Char)
			if AttrConns[Player] then
				AttrConns[Player]:Disconnect()
				AttrConns[Player] = nil
			end

			WeaveState[Player] = nil
			WeaveSince[Player] = nil

			AttrConns[Player] = Char:GetAttributeChangedSignal("WeaveFrames"):Connect(function()
				Evaluate(Player)
			end)

			HookAnimator(Player, Char)
		end

		Conn(Player.CharacterAdded:Connect(HookChar))

		if Player.Character then
			HookChar(Player.Character)
		end
	end

	for _, Player in ipairs(Players:GetPlayers()) do
		HookPlayer(Player)
	end

	Conn(Players.PlayerAdded:Connect(HookPlayer))

	Conn(Players.PlayerRemoving:Connect(function(Player)
		WeaveState[Player] = nil
		WeaveSince[Player] = nil
		LastWeaveAt[Player] = nil
		LastPlayerAt[Player] = nil

		if AttrConns[Player] then
			AttrConns[Player]:Disconnect()
			AttrConns[Player] = nil
		end

		if AnimConns[Player] then
			AnimConns[Player]:Disconnect()
			AnimConns[Player] = nil
		end
	end))

	local function Poll()
		if not KaOn then
			return
		end

		local MyChar = LocalPlayer.Character
		local MyRoot = MyChar and MyChar:FindFirstChild("HumanoidRootPart")

		if not MyRoot then
			return
		end

		for _, Player in ipairs(Players:GetPlayers()) do
			if Player ~= LocalPlayer and not Shared.IsTeammate(Player) then
				local Char = Player.Character
				local Root = Char and Char:FindFirstChild("HumanoidRootPart")

				if Root and (Root.Position - MyRoot.Position).Magnitude <= KaRange + 6 then
					pcall(Evaluate, Player)
				else
					WeaveState[Player] = nil
					WeaveSince[Player] = nil
				end
			end
		end
	end

	Conn(RunService.Heartbeat:Connect(Poll))

	do
		local StyleOn = false
		local STYLE_OPTIONS = { "Boxer", "Philly" }
		local StyleChoice = "Boxer"

		if type(Config.StyleLabChoice) == "string" and table.find(STYLE_OPTIONS, Config.StyleLabChoice) then
			StyleChoice = Config.StyleLabChoice
		end

		local function ApplyStyle()
			if not StyleOn then
				return
			end

			local Character = LocalPlayer.Character

			if Character then
				pcall(function()
					Character:SetAttribute("Style", StyleChoice)
				end)
			end
		end

		local StyleToggle = CreateToggle(KaPage, "Styles", false, function(State)
			StyleOn = State
			ApplyStyle()
		end, "StyleLabOn")
		StyleToggle.LayoutOrder = 7

		local StyleHolder = New("Frame", {
			Size = UDim2.new(1, -2, 0, 40),
			BackgroundColor3 = ROW_BG,
			BackgroundTransparency = ROW_TRANSP,
			BorderSizePixel = 0,
			LayoutOrder = 8,
		}, KaPage)
		Corner(StyleHolder, 8)

		New("TextLabel", {
			Size = UDim2.new(1, -140, 1, 0),
			Position = UDim2.new(0, 11, 0, 0),
			BackgroundTransparency = 1,
			Text = "Labs",
			TextColor3 = WHITE,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, StyleHolder)

		local StyleButton = New("TextButton", {
			Size = UDim2.new(0, 110, 0, 26),
			Position = UDim2.new(1, -120, 0.5, -13),
			BackgroundColor3 = CONTROL,
			Text = StyleChoice,
			TextColor3 = WHITE,
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			AutoButtonColor = false,
			BorderSizePixel = 0,
		}, StyleHolder)
		Corner(StyleButton, 7)

		StyleButton.MouseButton1Click:Connect(function()
			local Index = table.find(STYLE_OPTIONS, StyleChoice) or 1
			StyleChoice = STYLE_OPTIONS[Index % #STYLE_OPTIONS + 1]
			StyleButton.Text = StyleChoice
			Config.StyleLabChoice = StyleChoice
			SaveConfig()
			ApplyStyle()
		end)

		Conn(LocalPlayer.CharacterAdded:Connect(function()
			task.wait(1.5)
			ApplyStyle()
		end))

		task.spawn(function()
			task.wait(1.5)
			ApplyStyle()

			while UIAlive do
				if StyleOn then
					local Character = LocalPlayer.Character

					if Character and Character:GetAttribute("Style") ~= StyleChoice then
						pcall(function()
							Character:SetAttribute("Style", StyleChoice)
						end)
					end
				end

				task.wait(0.5)
			end
		end)
	end

	CreateGap(KaPage, 6, 9)

	local KaToggle = CreateToggle(KaPage, "Auto Ka", false, function(Value)
		KaOn = Value

		if Value then
			task.spawn(LoadModules)
		else
			table.clear(WeaveState)
			table.clear(WeaveSince)
		end
	end, "AutoKa")
	KaToggle.LayoutOrder = 10

	local KaRangeSlider = CreateSlider(KaPage, "Range", 3, 30, 0.1, 14.3, function(Value)
		KaRange = Value
	end, "AutoKaRange2")
	KaRangeSlider.LayoutOrder = 11

	local CdAllSlider = CreateSlider(KaPage, "Cooldown All", 0, 2, 0.01, 0, function(Value)
		CooldownAll = Value
	end, "AutoKaCdAll3")
	CdAllSlider.LayoutOrder = 12

	local MultiToggle = CreateToggle(KaPage, "Hits", true, function(State)
		MultiOn = State
	end, "AutoKaMultis")
	MultiToggle.LayoutOrder = 13

	local MultiSlider = CreateSlider(KaPage, "Amount", 1, 5, 1, 3, function(Value)
		MultiCount = Value
	end, "AutoKaMultiAmt2")
	MultiSlider.LayoutOrder = 14

	local KaCritToggle = CreateToggle(KaPage, "Heavy", true, function(State)
		CritOn = State
	end, "AutoKaCrit")
	KaCritToggle.LayoutOrder = 15
end)

RunSection(function()
	local NoBounceOn = false
	local OriginalGravity = workspace.Gravity
	local BounceUntil = 0
	local StateConn

	local function BindHumanoid(Character)
		if StateConn then
			StateConn:Disconnect()
			StateConn = nil
		end

		local Humanoid = Character and Character:WaitForChild("Humanoid", 5)

		if not Humanoid then
			return
		end

		StateConn = Humanoid.StateChanged:Connect(function(_, NewState)
			if NewState == Enum.HumanoidStateType.Landed then
				BounceUntil = os.clock() + 0.25
			elseif NewState == Enum.HumanoidStateType.Jumping then
				BounceUntil = 0
			end
		end)
	end

	if LocalPlayer.Character then
		task.spawn(BindHumanoid, LocalPlayer.Character)
	end

	Conn(LocalPlayer.CharacterAdded:Connect(function(Character)
		task.spawn(BindHumanoid, Character)
	end))

	Conn(RunService.Heartbeat:Connect(function()
		if not NoBounceOn then
			return
		end

		if workspace.Gravity ~= 700 then
			workspace.Gravity = 700
		end

		if os.clock() >= BounceUntil then
			return
		end

		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Humanoid or not Root then
			return
		end

		if Humanoid.FloorMaterial ~= Enum.Material.Air then
			local Velocity = Root.AssemblyLinearVelocity

			if Velocity.Y > 0 then
				Root.AssemblyLinearVelocity = Vector3.new(Velocity.X, 0, Velocity.Z)
			end
		end
	end))

	OnCleanup(function()
		if NoBounceOn then
			workspace.Gravity = OriginalGravity
		end

		if StateConn then
			StateConn:Disconnect()
		end
	end)

	local NoBounceToggle = CreateToggle(MiscPage, "No Bounce", false, function(State)
		NoBounceOn = State

		if State then
			OriginalGravity = workspace.Gravity
			workspace.Gravity = 700
		else
			workspace.Gravity = OriginalGravity
			BounceUntil = 0
		end
	end, "NoBounce")
	NoBounceToggle.LayoutOrder = 1

	local AntiFlingOn = false
	local Disabled = setmetatable({}, { __mode = "k" })

	local function RestoreCollisions()
		for Part in pairs(Disabled) do
			Disabled[Part] = nil

			if Part.Parent then
				pcall(function()
					Part.CanCollide = true
				end)
			end
		end
	end

	Conn(RunService.Stepped:Connect(function()
		if not AntiFlingOn then
			return
		end

		for _, Player in ipairs(Players:GetPlayers()) do
			local Character = Player ~= LocalPlayer and Player.Character

			if Character then
				for _, Part in ipairs(Character:GetDescendants()) do
					if Part:IsA("BasePart") and Part.CanCollide then
						Disabled[Part] = true
						Part.CanCollide = false
					end
				end
			end
		end
	end))

	Conn(RunService.Heartbeat:Connect(function()
		if not AntiFlingOn then
