local function SelectTab(name)
	if Selected == name then
		return
	end

	Selected = name

	for tabName, tab in pairs(Tabs) do
		local on = tabName == name

		TweenService:Create(tab.button, TweenInfo.new(0.2), {
			BackgroundTransparency = on and 0.86 or 1,
		}):Play()

		TweenService:Create(tab.label, TweenInfo.new(0.2), {
			TextColor3 = on and WHITE or GREY,
		}):Play()

		TweenService:Create(tab.marker, TweenInfo.new(0.25, Enum.EasingStyle.Back), {
			Size = on and UDim2.fromOffset(3, 14) or UDim2.fromOffset(3, 0),
		}):Play()
	end

	for pageName, page in pairs(Pages) do
		if pageName == name then
			page.Visible = true
			page.Position = UDim2.new(0, 22, 0, 12)
			TweenService:Create(page, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(0, 12, 0, 12),
			}):Play()
		else
			page.Visible = false
		end
	end
end

local function AddTab(name, order, parentButton)
	local button = parentButton or New("TextButton", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = order or (#Tabs + 1),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 4,
	}, TabList)
	Corner(button, INNER - 4)

	local marker = New("Frame", {
		Size = UDim2.fromOffset(3, 0),
		Position = UDim2.new(0, 4, 0.5, -7),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 5,
	}, button)
	Corner(marker, 2)

	local label = New("TextLabel", {
		Size = UDim2.new(1, -24, 1, 0),
		Position = UDim2.new(0, 14, 0, 0),
		BackgroundTransparency = 1,
		Text = name,
		TextColor3 = GREY,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 5,
	}, button)

	local page = MakePage()
	page.Name = name
	Pages[name] = page
	Tabs[name] = { button = button, label = label, marker = marker }

	button.MouseButton1Click:Connect(function()
		SelectTab(name)
	end)

	button.MouseEnter:Connect(function()
		if Selected ~= name then
			TweenService:Create(button, TweenInfo.new(0.15), { BackgroundTransparency = 0.94 }):Play()
			TweenService:Create(label, TweenInfo.new(0.15), { TextColor3 = WHITE }):Play()
		end
	end)

	button.MouseLeave:Connect(function()
		if Selected ~= name then
			TweenService:Create(button, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(0.15), { TextColor3 = GREY }):Play()
		end
	end)

	if not Selected then
		SelectTab(name)
	end

	return page
end

