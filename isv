	UpdateControls = function()
		local cfg = SelectedName and Store.configs[SelectedName]
		local risk = cfg and cfg.risk

		for i, opt in ipairs(RISKS) do
			local B = RiskButtons[i]

			if B then
				local on = (risk == opt)
				B.BackgroundColor3 = S.A1
				B.BackgroundTransparency = on and 0.15 or 1
				B.TextColor3 = on and BLACK or DIM
			end
		end

		if AutoSwitch then
			local on = SelectedName ~= nil and Store.autoload == SelectedName
			AutoSwitch.BackgroundColor3 = on and S.A1 or CONTROL
